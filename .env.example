NODE_ENV=development
PORT=10000
APP_URL=http://localhost:10000

# Telegram bot token created with @BotFather. Do not commit a real token.
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_AUTO_REGISTER=false
BOT_MODE=polling

# PostgreSQL connection string. Create the database before starting the API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hendy_ai_cover
DATABASE_SSL=false

# Cloudflare R2 S3-compatible storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hendy-ai-cover
R2_ENDPOINT=
R2_REGION=auto

# API/worker mutual authentication. Use at least 32 random characters.
AI_WORKER_CALLBACK_SECRET=
API_BASE_URL=http://api:10000

# Audio/job limits. Telegram Bot API getFile downloads are limited to 20 MB.
MAX_AUDIO_SIZE_MB=20
MAX_AUDIO_DURATION_SECONDS=180
MAX_ACTIVE_JOBS_PER_USER=2
MAX_JOB_ATTEMPTS=3
JOB_STALE_MINUTES=90
WORKER_POLL_SECONDS=5

# Python worker / RVC / Demucs configuration.
VOICE_CATALOG_PATH=./config/voices.json
RVC_PROJECT_ROOT=/opt/rvc
RVC_PYTHON=/usr/local/bin/python
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
DEMUCS_SEGMENT_SECONDS=7
VOCAL_GAIN=1.0
INSTRUMENTAL_GAIN=0.95
OUTPUT_BITRATE=192k
TEMP_ROOT=/tmp/hendy-ai-cover
